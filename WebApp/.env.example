# Default shared model for every Asitra client.
AI_PROVIDER=openai
OPENAI_API_KEY=

# Independent web authentication. Generate at least 32 random bytes for the
# secret and keep every value in the hosting secret store—not in source code.
BETTER_AUTH_SECRET=
ASITRA_PUBLIC_URL=https://asitra.app
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_WEB_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_P8=

# The native Apple app's Sign in with Apple audience.
APPLE_SIGN_IN_AUDIENCE=com.devganatra.sakhya

# Optional self-hosted/OpenAI-compatible model gateway.
# Set AI_PROVIDER=openai-compatible and configure all three values.
CUSTOM_AI_BASE_URL=https://ai.example.com
CUSTOM_AI_API_KEY=
CUSTOM_AI_MODEL=
