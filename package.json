{
  "name": "asitra-monorepo",
  "version": "0.2.0-beta.8",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "npm --prefix WebApp ci && npm --prefix WebApp run build && mkdir -p dist && cp -R WebApp/dist/. dist/",
    "test": "npm --prefix WebApp test",
    "lint": "npm --prefix WebApp run lint",
    "release:set": "node scripts/set-release.mjs",
    "release:check": "node scripts/release-policy.mjs"
  }
}
